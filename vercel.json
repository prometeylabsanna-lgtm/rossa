{
  "version": 2,
  "installCommand": "pip install -r requirements-vercel.txt",
  "buildCommand": "bash scripts/build_vercel.sh",
  "functions": {
    "api/index.py": {
      "maxDuration": 10,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
